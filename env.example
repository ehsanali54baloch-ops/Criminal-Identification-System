# Copy this file to ".env" and fill in your values.
# .env is in .gitignore, so your password is NOT uploaded to GitHub.

# Who receives the alert emails
ADMIN_EMAIL=admin@example.com

# The Gmail account that sends the alerts
SMTP_USER=yourproject@gmail.com
# Gmail App Password (16 letters) - NOT your normal Gmail password
SMTP_PASSWORD=abcd efgh ijkl mnop

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587

# Optional: seconds between repeat alarms / emails for the same person
ALERT_COOLDOWN_SEC=15
EMAIL_COOLDOWN_SEC=60
